{
  "name": "@jfa.dev/hyperscaler-services",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vp lint && vp build",
    "check": "vp check --fix && vp lint --type-check --fix",
    "dev": "vp dev --port 3102 --host",
    "format": "vp fmt",
    "generate:search-index": "bun run scripts/build-service-search-index.ts",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --fix",
    "prebuild": "bun run generate:search-index",
    "predev": "bun run generate:search-index",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/pretendard": "^5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-start": "1.168.44",
    "@tanstack/react-table": "9.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.17.0",
    "tailwind-merge": "3.6.0",
    "vaul-base": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
