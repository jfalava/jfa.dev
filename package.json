{
  "name": "@jfa.dev/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "common",
      "iac",
      "web/*",
      "function/*"
    ],
    "catalogs": {
      "backend": {
        "hono": "4.13.2",
        "fuse.js": "7.5.0"
      },
      "ui": {
        "lucide-react": "1.31.0",
        "shadcn": "4.18.0",
        "sonner": "2.0.8"
      },
      "build": {
        "@vitejs/plugin-react": "6.1.0",
        "oxfmt": "0.63.0",
        "oxlint": "1.79.0",
        "oxc-transform-react": "0.145.0",
        "@oxlint/plugins": "1.79.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
        "vite-plus": "0.2.9",
        "vitest": "4.1.10"
      },
      "cloudflare": {
        "@cloudflare/vitest-pool-workers": "0.21.3"
      },
      "iac": {
        "alchemy": "2.0.0-beta.72",
        "effect": "4.0.0-rc.108",
        "@effect/platform-bun": "4.0.0-rc.108",
        "@effect/platform-node": "4.0.0-rc.108"
      },
      "react": {
        "@base-ui/react": "1.7.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-aria-components": "1.20.0"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.0",
        "@fontsource/pretendard": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0"
      },
      "tanstack": {
        "@tanstack/react-router": "1.170.29",
        "@tanstack/react-router-ssr-query": "1.167.1",
        "@tanstack/react-start": "1.168.46",
        "@tanstack/router-plugin": "1.168.32",
        "@tanstack/react-hotkeys": "0.10.0",
        "@tanstack/react-table": "9.1.2",
        "@tanstack/query-async-storage-persister": "5.101.4",
        "@tanstack/react-query": "5.101.4",
        "@tanstack/react-query-persist-client": "5.101.4"
      },
      "types": {
        "@types/bun": "1.3.14",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@cloudflare/workers-types": "5.20260815.1"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/og-img-gen --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects check",
    "deploy": "bun run --filter @jfa.dev/iac deploy",
    "dev": "bun run --filter @jfa.dev/iac dev",
    "format:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/og-img-gen --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects format",
    "iac:plan": "bun run --filter @jfa.dev/iac plan",
    "lint:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/og-img-gen --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects lint",
    "predeploy": "bun run lint:global && bun run test:global",
    "test:global": "bun run --filter @jfa.dev/keweke --filter @jfa.dev/common --filter @jfa.dev/router test"
  },
  "dependencies": {
    "jsdom": "30.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "1.3.14",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "packageManager": "bun@1.3.14"
}
