{
  "name": "@jfa.dev/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "common",
      "iac",
      "web/*",
      "function/*"
    ],
    "catalogs": {
      "backend": {
        "hono": "4.12.31"
      },
      "build": {
        "@vitejs/plugin-react": "6.0.4",
        "oxfmt": "0.56.0",
        "oxlint": "1.78.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
        "vite-plus": "0.2.9",
        "vitest": "4.1.2"
      },
      "cloudflare": {
        "@cloudflare/workers-types": "5.20260721.1"
      },
      "iac": {
        "alchemy": "2.0.0-beta.72",
        "effect": "4.0.0-rc.108",
        "@effect/platform-bun": "4.0.0-rc.108",
        "@effect/platform-node": "4.0.0-rc.108"
      },
      "react-ui": {
        "@base-ui/react": "1.6.0",
        "lucide-react": "1.25.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-aria-components": "1.20.0",
        "shadcn": "4.13.1"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.0",
        "@fontsource/pretendard": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0"
      },
      "tanstack": {
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-router-ssr-query": "1.167.1",
        "@tanstack/react-start": "1.168.32",
        "@tanstack/router-plugin": "1.168.23"
      },
      "types": {
        "@types/bun": "1.3.14",
        "@types/node": "26.1.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3"
      }
    }
  },
  "type": "module",
  "scripts": {
    "deploy": "bun run --filter @jfa.dev/iac deploy",
    "dev": "bun run --filter @jfa.dev/iac dev",
    "format:global": "bun run --filter @jfa.dev/landing format && bun run --filter @jfa.dev/landing format && bun run --filter @jfa.dev/og-img-gen format && bun run --filter @jfa.dev/og-img-gen format && bun run --filter @jfa.dev/hyperscaler-services format && bun run --filter @jfa.dev/hyperscaler-services format",
    "iac:plan": "bun run --filter @jfa.dev/iac plan",
    "predeploy": "bun run --filter @jfa.dev/common check && bun run --filter @jfa.dev/common test && bun run --filter @jfa.dev/landing check && bun run --filter @jfa.dev/landing lint && bun run --filter @jfa.dev/og-img-gen check && bun run --filter @jfa.dev/og-img-gen lint && bun run --filter @jfa.dev/hyperscaler-services check && bun run --filter @jfa.dev/hyperscaler-services lint && bun run --filter @jfa.dev/keweke check && bun run --filter @jfa.dev/keweke check:workers && bun run --filter @jfa.dev/keweke lint && bun run --filter @jfa.dev/keweke test && bun run --filter @jfa.dev/keweke test:workers && bun run format:global"
  },
  "dependencies": {
    "jsdom": "30.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "1.3.14",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "packageManager": "bun@1.3.14"
}
