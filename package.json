{
  "name": "@jfa.dev/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "common",
      "iac",
      "web/*",
      "function/*"
    ],
    "catalogs": {
      "backend": {
        "hono": "4.13.17",
        "fuse.js": "7.5.0",
        "fastest-levenshtein": "1.0.16",
        "pluralize": "8.0.0"
      },
      "ui": {
        "lucide-react": "1.70.0",
        "react-resizable-panels": "4.19.1",
        "shadcn": "4.23.0",
        "sonner": "2.0.8",
        "blobatar": "2.7.0"
      },
      "build": {
        "@vitejs/plugin-react": "6.2.1",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "oxc-transform-react": "0.157.0",
        "@oxlint/plugins": "1.92.0",
        "oxlint-tsgolint": "7.0.2006",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "vite-plus": "1.5.0",
        "vitest": "5.1.0",
        "tsrs": "0.23.0-ts7.1.0-beta"
      },
      "cloudflare": {
        "@cloudflare/vitest-pool-workers": "0.23.0"
      },
      "iac": {
        "alchemy": "2.0.0-beta.85",
        "@alchemy.run/cloudflare": "2.0.0-beta.85",
        "effect": "4.1.2",
        "@effect/platform-bun": "4.1.2",
        "@effect/platform-node": "4.1.2"
      },
      "react": {
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-aria-components": "1.22.1"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.5",
        "class-variance-authority": "0.7.1",
        "cn": "0.5.2",
        "tailwindcss": "4.3.5",
        "tw-animate-css": "1.4.0"
      },
      "tanstack": {
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.5",
        "@tanstack/router-plugin": "1.169.0",
        "@tanstack/react-hotkeys": "0.22.0",
        "@tanstack/react-table": "9.3.1",
        "@tanstack/query-async-storage-persister": "5.107.1",
        "@tanstack/react-query": "5.107.1",
        "@tanstack/react-query-persist-client": "5.107.1"
      },
      "types": {
        "bun-types": "1.4.4",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@cloudflare/workers-types": "5.20261109.1"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint:global && bun run lint:ui && bun run typecheck:global && bun run test:global",
    "deploy": "bun run --filter @jfa.dev/iac deploy",
    "dev": "bun run --filter @jfa.dev/iac dev",
    "fetch:playlist": "bun run scripts/fetch-apple-playlist.ts",
    "format:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/opengraph --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/docs --filter @jfa.dev/branding --filter @jfa.dev/playlists --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects --filter @jfa.dev/playlists format",
    "iac:plan": "bun run --filter @jfa.dev/iac plan",
    "lint:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/opengraph --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/docs --filter @jfa.dev/branding --filter @jfa.dev/playlists --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects --filter @jfa.dev/playlists lint",
    "lint:ui": "bun tools/ui-lint/index.ts",
    "predeploy": "bun run check",
    "test:global": "bun run --filter @jfa.dev/keweke --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/iac test && bun test tools/ui-lint",
    "typecheck:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/opengraph --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/docs --filter @jfa.dev/branding --filter @jfa.dev/playlists --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects --filter @jfa.dev/playlists typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:build",
    "@types/node": "catalog:types",
    "bun-types": "catalog:types",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "tsrs": "catalog:build",
    "typescript": "catalog:build",
    "vite-plus": "catalog:build"
  }
}
