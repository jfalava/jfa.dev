{
  "name": "@jfa.dev/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "common",
      "iac",
      "web/*",
      "function/*"
    ],
    "catalogs": {
      "backend": {
        "hono": "4.13.5",
        "fuse.js": "7.5.0"
      },
      "ui": {
        "lucide-react": "1.34.0",
        "react-resizable-panels": "4.12.3",
        "shadcn": "4.19.0",
        "sonner": "2.0.8"
      },
      "build": {
        "@vitejs/plugin-react": "6.1.0",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "oxc-transform-react": "0.147.0",
        "@oxlint/plugins": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vite-plus": "0.3.0",
        "vitest": "4.1.11"
      },
      "cloudflare": {
        "@cloudflare/vitest-pool-workers": "0.22.0"
      },
      "iac": {
        "alchemy": "2.0.0-beta.74",
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112"
      },
      "react": {
        "@base-ui/react": "1.7.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-aria-components": "1.20.0"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.0",
        "@fontsource/pretendard": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0"
      },
      "tanstack": {
        "@tanstack/react-router": "1.170.32",
        "@tanstack/react-router-ssr-query": "1.167.2",
        "@tanstack/react-start": "1.168.49",
        "@tanstack/router-plugin": "1.168.35",
        "@tanstack/react-hotkeys": "0.10.0",
        "@tanstack/react-table": "9.2.3",
        "@tanstack/query-async-storage-persister": "5.102.8",
        "@tanstack/react-query": "5.102.8",
        "@tanstack/react-query-persist-client": "5.102.8"
      },
      "types": {
        "@types/bun": "1.4.0",
        "@types/node": "26.4.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@cloudflare/workers-types": "5.20260827.1"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/opengraph --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/docs --filter @jfa.dev/branding --filter @jfa.dev/playlist --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects --filter @jfa.dev/playlist check",
    "deploy": "bun run --filter @jfa.dev/iac deploy",
    "dev": "bun run --filter @jfa.dev/iac dev",
    "fetch:playlist": "bun run scripts/fetch-apple-playlist.ts",
    "format:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/opengraph --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/docs --filter @jfa.dev/branding --filter @jfa.dev/playlist --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects --filter @jfa.dev/playlist format",
    "iac:plan": "bun run --filter @jfa.dev/iac plan",
    "lint:global": "bun run --filter @jfa.dev/landing --filter @jfa.dev/opengraph --filter @jfa.dev/hyperscaler-services --filter @jfa.dev/keweke --filter @jfa.dev/docs --filter @jfa.dev/branding --filter @jfa.dev/playlist --filter @jfa.dev/common --filter @jfa.dev/router --filter @jfa.dev/redirects --filter @jfa.dev/playlist lint",
    "predeploy": "bun run lint:global && bun run test:global",
    "test:global": "bun run --filter @jfa.dev/keweke --filter @jfa.dev/common --filter @jfa.dev/router test"
  },
  "dependencies": {
    "jsdom": "30.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "packageManager": "bun@1.4.0"
}
