# Environment for `alchemy deploy` (bun run deploy from iac/).
#
# Alchemy auto-loads `.env` from the current working directory (see
# `alchemy/src/Util/ConfigProvider.ts`) and feeds it to `effect/Config`,
# which `iac/src/workers.ts` reads via `Config.redacted`. Values defined
# here WIN over the shell environment for the same key.
#
# These values are upload-time only: the deploy pushes them into the
# Cloudflare Secrets Store (`PlaylistLastfmApiKey` / `PlaylistLastfmUser`),
# and the playlist worker reads them at runtime via `env.LASTFM_*.get()`.
# Rotate by editing this file (or the CI secret) and redeploying.

# Last.fm API key — https://www.last.fm/api/account/create
LASTFM_API_KEY=""

# Last.fm username whose recent tracks feed the now-playing widget
LASTFM_USER=""
