#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bun_bin="$HOME/.bun/bin/bun"

if [[ ! -x "$bun_bin" ]]; then
  echo "Bun is missing; run .agents/setup to restore the toolchain." >&2
  exit 1
fi

if [[ ! -d "$repo_root/node_modules" ]]; then
  echo "Dependencies are missing; run .agents/setup to restore them." >&2
  exit 1
fi

echo "Orb resume check complete (Bun $($bun_bin --version))."
