#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bun_version="1.3.14"
bun_dir="$HOME/.bun"
bun_bin="$bun_dir/bin/bun"
node_version="22.23.2"
node_dir="$HOME/.local/node-v${node_version}"
node_bin="$node_dir/bin/node"

step() {
  printf '\n==> %s\n' "$1"
}

step "Installing Bun ${bun_version} if needed"
if [[ ! -x "$bun_bin" ]] || [[ "$($bun_bin --version)" != "$bun_version" ]]; then
  if ! command -v unzip >/dev/null 2>&1; then
    apt-get update
    apt-get install -y unzip
  fi

  archive="$(mktemp)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${bun_version}/bun-linux-x64.zip" -o "$archive"
  rm -rf "$bun_dir"
  mkdir -p "$bun_dir/bin"
  unzip -q "$archive" -d "$bun_dir"
  mv "$bun_dir/bun-linux-x64/bun" "$bun_bin"
  rmdir "$bun_dir/bun-linux-x64"
fi

if ! grep -Fqx '# jfa.dev Bun toolchain' "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# jfa.dev Bun toolchain
export PATH="$HOME/.bun/bin:$PATH"
EOF
fi

step "Installing Node.js ${node_version} if needed"
if [[ ! -x "$node_bin" ]] || [[ "$($node_bin --version)" != "v${node_version}" ]]; then
  node_archive="$(mktemp)"
  node_checksums="$(mktemp)"
  trap 'rm -f "${archive:-}" "$node_archive" "$node_checksums"' EXIT
  curl -fsSL "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" -o "$node_checksums"
  curl -fsSL "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-x64.tar.xz" -o "$node_archive"
  expected_checksum="$(grep " node-v${node_version}-linux-x64.tar.xz$" "$node_checksums" | cut -d ' ' -f 1)"
  printf '%s  %s\n' "$expected_checksum" "$node_archive" | sha256sum -c -
  rm -rf "$node_dir"
  mkdir -p "$(dirname "$node_dir")"
  tar -xJf "$node_archive" -C "$(dirname "$node_dir")"
  mv "$(dirname "$node_dir")/node-v${node_version}-linux-x64" "$node_dir"
fi

if ! grep -Fqx '# jfa.dev Node toolchain' "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# jfa.dev Node toolchain
export PATH="$HOME/.local/node-v22.23.2/bin:$PATH"
EOF
fi

step "Installing locked Bun dependencies"
cd "$repo_root"
"$bun_bin" install --frozen-lockfile

step "Setup complete"
